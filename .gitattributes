# Text diffs still work; only automatic line-ending conversion is disabled.
# Accept preserved Windows CRLF while keeping the other whitespace checks.
* -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
*.glb binary
*.png binary
*.jpg binary
*.task binary
*.rknn binary
*.tflite binary
*.binarypb binary
*.so binary
